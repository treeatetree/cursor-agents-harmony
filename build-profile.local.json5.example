{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/absolute/path/to/debug.cer",
          "keyAlias": "debugKey",
          "keyPassword": "DO_NOT_COMMIT",
          "profile": "/absolute/path/to/debug.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/absolute/path/to/debug.p12",
          "storePassword": "DO_NOT_COMMIT"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "6.1.1(24)",
        "compileSdkVersion": "6.1.1(24)",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
