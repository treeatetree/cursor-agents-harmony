new file mode 100644
index 0000000..795c40a
--- /dev/null
+++ b/entry/src/main/ets/components/HuButton.ets
@@ -0,0 +1,74 @@
+import { Tokens } from '../theme/Tokens';
+
+/**
+ * HeroUI-style button: accent fill, 24 radius, press scale 0.97.
+ * variant: primary | secondary | danger
+ */
+@Component
+export struct HuButton {
+  @Prop label: string = '';
+  @Prop variant: string = 'primary';
+  @Prop enabled: boolean = true;
+  @Prop fillWidth: boolean = false;
+  @State private pressed: boolean = false;
+  onTap: () => void = () => {
+  };
+
+  private fg(): Resource {
+    if (!this.enabled) {
+      return $r('app.color.text_tertiary');
+    }
+    if (this.variant === 'secondary') {
+      return $r('app.color.text_primary');
+    }
+    return $r('app.color.accent_on');
+  }
+
+  private bg(): Resource {
+    if (!this.enabled) {
+      return $r('app.color.bg2');
+    }
+    if (this.variant === 'danger') {
+      return $r('app.color.err');
+    }
+    if (this.variant === 'secondary') {
+      return $r('app.color.bg2');
+    }
+    return $r('app.color.accent');
+  }
+
+  build() {
+    Text(this.label)
+      .fontSize(Tokens.typeCallout)
+      .fontWeight(FontWeight.Medium)
+      .fontColor(this.fg())
+      .textAlign(TextAlign.Center)
+      .height(Tokens.controlHLg)
+      .padding({ left: 18, right: 18 })
+      .constraintSize({ minWidth: this.fillWidth ? 0 : 88 })
+      .width(this.fillWidth ? '100%' : 'auto')
+      .backgroundColor(this.bg())
+      .borderRadius(Tokens.radiusCard)
+      .scale({
+        x: this.pressed && this.enabled ? Tokens.pressScale : 1,
+        y: this.pressed && this.enabled ? Tokens.pressScale : 1
+      })
+      .animation({ duration: 90, curve: Curve.EaseOut })
+      .opacity(this.enabled ? 1 : 0.55)
+      .onTouch((e: TouchEvent) => {
+        if (!this.enabled) {
+          return;
+        }
+        if (e.type === TouchType.Down) {
+          this.pressed = true;
+        } else if (e.type === TouchType.Up || e.type === TouchType.Cancel) {
+          this.pressed = false;
+        }
+      })
+      .onClick(() => {
+        if (this.enabled) {
+          this.onTap();
+        }
+      })
+  }
+}
